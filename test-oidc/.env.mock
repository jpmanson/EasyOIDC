# EasyOIDC configuration pointing at the local mock-oauth2-server.
# The endpoints (authorization/token/userinfo/revoke) are resolved
# automatically from the discovery document (well_known_openid_url).

well_known_openid_url = http://localhost:8080/default/.well-known/openid-configuration

# The mock accepts any client_id / client_secret.
client_id = easyoidc-test
client_secret = easyoidc-secret
cookie_secret_key = any-secret-key

redirect_uri = http://localhost:5000/authorize
scope = openid,profile,email

# Application routes
app_login_route = /login
app_logout_route = /logout
app_authorize_route = /authorize
unrestricted_routes = /
post_logout_uri = http://localhost:5000
